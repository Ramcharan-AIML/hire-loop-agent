# Cold Mail Service env (names match cold_mail_sender/config.py). Copy to .env.
# --- LLM ---
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant

# --- SMTP (Gmail App Password, not your normal password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_NAME=

# --- Safety ---
DRY_RUN=true
SEND_MODE=draft            # draft | send
MAX_OUTREACH_PER_RUN=5

# --- Shared internal key (must match the other services) ---
INTERNAL_API_KEY=change-me-to-a-long-random-string
