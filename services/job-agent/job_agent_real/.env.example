# Firecrawl API key (required for Wellfound scraper)
# Get your key at: https://firecrawl.dev
FIRECRAWL_API_KEY=fc-your-api-key-here

# Delay between HTTP requests in seconds (default: 2)
REQUEST_DELAY=2

# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# Number of pages to scrape from Naukri (default: 3)
NAUKRI_PAGES=3
