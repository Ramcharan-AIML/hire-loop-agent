# ──────────────────────────────────────────────────────────────────────────
# Unified AI Job Application Platform — top-level env template (for docker-compose)
# Copy to .env and fill in. NEVER commit the filled-in .env.
# See docs/architecture.md §9 for the full variable reference.
# ──────────────────────────────────────────────────────────────────────────

# --- Shared internal auth (BFF <-> Python services) ---
INTERNAL_API_KEY=change-me-to-a-long-random-string

# --- Job Agent Service ---
FIRECRAWL_API_KEY=

# --- Resume Engine (Next.js, set in Vercel — listed here for reference) ---
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Cold Mail Service (names match cold_mail_sender/config.py) ---
# GROQ_API_KEY is shared with the Resume Engine
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=               # gmail address; also used as the sender/From
SMTP_PASSWORD=           # Gmail App Password (not your account password)
SENDER_NAME=
DRY_RUN=true             # safety: must be explicitly set false to send real email
SEND_MODE=draft          # draft | send
MAX_OUTREACH_PER_RUN=5

# --- Service discovery (used by the Next.js BFF) ---
JOB_AGENT_URL=http://localhost:8000
COLD_MAIL_URL=http://localhost:8001
