# =========================================================================
# Resume Shapeshifter — Environment Variables Configuration Template
# =========================================================================

# LLM Provider Configuration
# Allowed values: 'groq' or 'gemini'
# LLM_PROVIDER=groq

# Groq API Configuration (Required if LLM_PROVIDER=groq)
# Get your API key from: https://console.groq.com/
# GROQ_API_KEY=

# Google Gemini API Configuration (Required if LLM_PROVIDER=gemini)
# Get your API key from: https://aistudio.google.com/
# GOOGLE_API_KEY=gemini-2.0-flash

# Model Selection Override (Optional)
# Default for Groq: llama3-70b-8192 (high fidelity) or llama3-8b-8192 (fast/cost-efficient)
# Default for Gemini: gemini-2.0-flash
# LLM_MODEL=llama-3.3-70b-versatile

# Inference Settings (Optional)
# LLM_TEMPERATURE=0.3
# LLM_MAX_RETRIES=3

# =========================================================================
# Unified Platform — BFF service discovery (server-only, no NEXT_PUBLIC_)
# Used by the new /api/jobs/* and /api/outreach/* route handlers.
# =========================================================================
# JOB_AGENT_URL=http://localhost:8000
# COLD_MAIL_URL=http://localhost:8001
# INTERNAL_API_KEY=change-me-to-match-the-python-services

